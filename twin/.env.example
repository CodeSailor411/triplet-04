# Copy to .env and change the values. NEVER commit .env (it is in .gitignore).
# These are fake development keys. One secret per caller, so the Twin knows who is calling.
TWIN_KEY_CITY_BRAIN=dev-city-brain-key-change-me
TWIN_KEY_GUARDIAN=dev-guardian-key-change-me
# Key for the scenario tool (hidden from everyone who does not send it).
TWIN_KEY_SCENARIO=dev-scenario-key-change-me

# History in TimescaleDB (only when config/twin.yaml says storage.history: timescale). Fake dev password.
# TWIN_TIMESCALE_DSN=postgresql://twin:twin-dev-password@127.0.0.1:5432/twin

# Optional overrides
# TWIN_SEED=42
# TWIN_CONFIG=config/twin.yaml
