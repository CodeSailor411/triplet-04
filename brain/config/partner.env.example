# Copy the separately supplied private .env.partner to brain/.env.partner.
# This public template contains no credentials. Localhost assumes all services
# are on one computer; change URLs and BRAIN_HOST for a shared-network run.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8001
PEER_MODE=live
LLM_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
BRAIN_TWIN_CALLER_KEY=
BRAIN_GUARDIAN_CALLER_KEY=
BRAIN_SCENARIO_KEY=
TWIN_MCP_URL=http://127.0.0.1:8000/mcp
TWIN_EVENTS_URL=http://127.0.0.1:8000/events
TWIN_BRAIN_KEY=
TWIN_FEED_ENABLED=true
GUARDIAN_MCP_URL=http://127.0.0.1:8002/mcp
GUARDIAN_BRAIN_KEY=
GUARDIAN_CONTRACT_CONFIRMED=false
GUARDIAN_MAPPING_FILE=
GUARDIAN_SCORE_TOOL=CONFIRM_WITH_9ANTRA
GUARDIAN_TOKEN_TOOL=CONFIRM_WITH_9ANTRA
MOCK_INTEGRATION_PROFILE=true
SCENARIO_POLICY_FILE=
TWIN_PREVIEW_TOOL=preview_action
BRAIN_DEBUG_ENABLED=true
PEER_TIMEOUT_SECONDS=3
# Mock-only latency allowance for Gemini. Still rechecks the current incident,
# containment and token before sending. This is not a triplet safety threshold.
MAX_EVIDENCE_AGE_SECONDS=60
AI_TIMEOUT_SECONDS=60
AI_MAX_CALLS_PER_RUN=20
