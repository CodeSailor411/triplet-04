# Merge these selections into a LOCAL .env.partner.v3 with your existing Gemini,
# Twin, caller credentials, URLs and reviewed scenario-policy configuration.
# Never publish a completed environment file or use these placeholders as keys.
PEER_MODE=live
LLM_MODE=gemini
GUARDIAN_TRANSPORT=mcp_v3
GUARDIAN_MCP_URL=http://127.0.0.1:5000/mcp
GUARDIAN_BRAIN_KEY=REPLACE_WITH_GUARDIAN_BRAIN_MCP_BEARER_KEY
# Enable only after reviewing the v3 wire mapping, scale and provisional minima.
GUARDIAN_CONTRACT_CONFIRMED=false
TWIN_FEED_ENABLED=true
TWIN_MCP_URL=http://127.0.0.1:8000/mcp
TWIN_EVENTS_URL=http://127.0.0.1:8000/events
TWIN_PREVIEW_TOOL=preview_action
MOCK_INTEGRATION_PROFILE=true
MAX_EVIDENCE_AGE_SECONDS=60
