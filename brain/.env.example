# Fake local development values. Replace keys locally for a joint run.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8001
BRAIN_TWIN_CALLER_KEY=dev-twin-to-brain
BRAIN_GUARDIAN_CALLER_KEY=dev-guardian-to-brain
BRAIN_SCENARIO_KEY=dev-scenario-to-brain
TWIN_MCP_URL=http://127.0.0.1:8000/mcp
TWIN_BRAIN_KEY=dev-brain-to-twin
GUARDIAN_MCP_URL=http://127.0.0.1:8002/mcp
GUARDIAN_BRAIN_KEY=dev-brain-to-guardian
GUARDIAN_SCORE_TOOL=CONFIRM_WITH_9ANTRA
GUARDIAN_TOKEN_TOOL=CONFIRM_WITH_9ANTRA
LLM_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional live provider selected by Elyes. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
BRAIN_DEBUG_ENABLED=true
AI_TIMEOUT_SECONDS=30
AI_MAX_CALLS_PER_RUN=3
PEER_TIMEOUT_SECONDS=5

# Fixture defaults require no external services. Confirm contracts before switching live.
PEER_MODE=fixture
BRAIN_FIXTURE_CASE=mocks/cases/air_quality/base_case.json
GUARDIAN_CONTRACT_CONFIRMED=false
GUARDIAN_MAPPING_FILE=
# Leave optional Twin tools unset until confirmed and advertised.
