# Copy to .env and change the values. NEVER commit .env.
# These are the public example values. The Twin warns by name at start if a key still has one.
TWIN_KEY_CITY_BRAIN=dev-city-brain-key-change-me
TWIN_KEY_GUARDIAN=dev-guardian-key-change-me
TWIN_KEY_SCENARIO=dev-scenario-key-change-me

# Signed mode (the demo): uncomment both lines and paste the Guardian's PUBLIC key.
# Without them the Twin accepts the unsigned test token.
# TWIN_TOKEN_MODE=signed
# TWIN_GUARDIAN_PUBLIC_KEY=

# Optional
# TWIN_SEED=42

# Brain: the Twin key above is passed to it as TWIN_BRAIN_KEY. Its own settings (keys other layers use
# to call it, Gemini key, peer mode) go in brain/.env.partner, copied from brain/config/partner.env.example.
