# Local development values only. Copy this file to .env and replace every
# value marked CHANGE-ME. Never commit .env or real credentials.

# Twin caller keys (all distinct; minimum 8 characters)
TWIN_KEY_CITY_BRAIN=dev-city-brain-key-change-me
TWIN_KEY_GUARDIAN=dev-guardian-key-change-me
TWIN_KEY_SCENARIO=dev-scenario-key-change-me

# Guardian's inbound API/MCP keys
GUARDIAN_API_BEARER_KEY=dev-guardian-api-key-change-me
GUARDIAN_BRAIN_MCP_BEARER_KEY=dev-guardian-mcp-key-change-me

# Brain caller keys; BRAIN_GUARDIAN_CALLER_KEY is shared with Guardian's
# outbound notify_containment client.
BRAIN_TWIN_CALLER_KEY=dev-brain-twin-caller-key-change-me
BRAIN_GUARDIAN_CALLER_KEY=dev-brain-guardian-caller-key-change-me
BRAIN_SCENARIO_KEY=dev-brain-scenario-key-change-me

# Brain requires a non-empty key to start in live peer mode. Replace this with
# a valid key before invoking Gemini-backed planning.
GEMINI_API_KEY=dev-gemini-key-change-me
GEMINI_MODEL=gemini-3.5-flash-lite
PEER_MODE=live
LLM_MODE=gemini
TWIN_FEED_ENABLED=true
MOCK_INTEGRATION_PROFILE=true

# Optional local behavior
TWIN_SEED=42
BRAIN_DEBUG_ENABLED=true
